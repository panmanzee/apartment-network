-up" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=1;endArrow=none;fontSize=10;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="net" target="vpn"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="15" y="175"/><mxPoint x="15" y="605"/></Array></mxGeometry></mxCell><mxCell id="fw" value="&lt;b&gt;fw-edge&lt;/b&gt; FortiGate 60F (10.20.10.1)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;fillOpacity=40;" vertex="1" parent="1"><mxGeometry x="360" y="100" width="360" height="560" as="geometry"/></mxCell><mxCell id="sdw" value="SD-WAN zone virtual-wan-link&lt;br&gt;wan1 + wan2, ping health-check, failover" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="380" y="150" width="320" height="70" as="geometry"/></mxCell><mxCell id="c5" value="NAT (outgoing iface) + per-IP shapers&lt;br&gt;tenant 100/50 Mbps, guest 20/10 Mbps" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="380" y="235" width="320" height="70" as="geometry"/></mxCell><mxCell id="ipsec" value="IPsec dial-up owner-vpn-a / -b&lt;br&gt;pool 10.20.50.0/24&lt;br&gt;allowed: MGMT, CCTV" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="380" y="320" width="320" height="80" as="geometry"/></mxCell><mxCell id="c6" value="DHCP server per VLAN, captive portal on GUEST&lt;br&gt;SNMPv3, admin only from MGMT" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="380" y="415" width="320" height="70" as="geometry"/></mxCell><mxCell id="lag" value="&lt;b&gt;lag-core&lt;/b&gt; (internal1 + internal2, LACP)&lt;br&gt;VLAN subinterfaces, gateway of e